# Pinch sandbox credentials — get these from the Pinch Portal:
#   1. Log in / sign up at https://web.getpinch.com.au
#   2. Switch to TEST mode (top of the portal)
#   3. API Keys -> create an Application  ->  copy Application Id + Secret
#   4. Copy the publishable key (pk_test_...) for CaptureJs (client-side tokenisation)

PINCH_ENV=test                       # test | live  (also switches the /test vs /live API path)
PINCH_APP_ID=mch_test_xxx            # Application Id (or Merchant Id) — test keys start mch_test_
PINCH_SECRET=sk_test_xxx             # Application Secret (or Merchant Secret Key) — sk_test_
PINCH_PUBLISHABLE_KEY=pk_test_xxx    # used by the browser CaptureJs widget
PINCH_WEBHOOK_SECRET=                # secret returned when you create the webhook
PINCH_VERSION=2020.1                 # API version pinned via the pinch-version header

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
